<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Accent left border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tetraBubbleAiBorder"/>
            <corners
                android:topLeftRadius="@dimen/bubble_corner_tail"
                android:topRightRadius="@dimen/bubble_corner_main"
                android:bottomLeftRadius="@dimen/bubble_corner_tail"
                android:bottomRightRadius="@dimen/bubble_corner_main"/>
        </shape>
    </item>
    <!-- Main bubble shifted right by 4dp to show border -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tetraBubbleAi"/>
            <corners
                android:topLeftRadius="@dimen/bubble_corner_tail"
                android:topRightRadius="@dimen/bubble_corner_main"
                android:bottomLeftRadius="@dimen/bubble_corner_tail"
                android:bottomRightRadius="@dimen/bubble_corner_main"/>
        </shape>
    </item>
</layer-list>
